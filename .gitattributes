# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Windows scripts must keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.jar binary
*.aab binary
*.apk binary
*.jks binary
*.keystore binary
*.so binary
*.class binary
