<?xml version="1.0" encoding="utf-8"?>
<!-- Zen circle mark: ink ring + paper gap + focus dot. Warm monochrome, no gradient. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="64dp"
    android:height="64dp"
    android:viewportWidth="64"
    android:viewportHeight="64">
    <!-- outer ink disc -->
    <path
        android:fillColor="#2F3437"
        android:pathData="M32,2 A30,30 0 1 1 31.99,2 Z" />
    <!-- paper centre cut-out (makes the ring) -->
    <path
        android:fillColor="#F7F6F3"
        android:pathData="M32,12 A20,20 0 1 1 31.99,12 Z" />
    <!-- ink focus dot -->
    <path
        android:fillColor="#2F3437"
        android:pathData="M32,26 m-6,0 a6,6 0 1 1 12,0 a6,6 0 1 1 -12,0" />
</vector>
