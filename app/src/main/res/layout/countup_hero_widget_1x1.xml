<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hero_1x1_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hero_widget_bg"
    android:paddingStart="8dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp">

    <!-- Active State: Counter & Two-Line Dynamic Title -->
    <LinearLayout
        android:id="@+id/hero_1x1_content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Top: Count + 'd' + Milestone Dot -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/hero_1x1_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="22sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:textColor="#2C2416"
                android:text="100" />

            <TextView
                android:id="@+id/hero_1x1_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:textColor="#8C7E70"
                android:text="d" />

            <ImageView
                android:id="@+id/hero_1x1_milestone_dot"
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/hero_milestone_dot"
                android:visibility="gone"
                android:contentDescription="@null" />
        </LinearLayout>

        <!-- Bottom: Two Stacked Dynamic Lines for zero truncation -->
        <LinearLayout
            android:id="@+id/hero_1x1_title_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/hero_1x1_line1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:textColor="#5D5043"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="SOBRIETY" />

            <TextView
                android:id="@+id/hero_1x1_line2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="8.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:textColor="#8C7E70"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="STREAK" />
        </LinearLayout>
    </LinearLayout>

    <!-- Empty State overlay -->
    <TextView
        android:id="@+id/hero_1x1_empty_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#8C7E70"
        android:text="@string/hero_widget_empty"
        android:visibility="gone" />

</RelativeLayout>
