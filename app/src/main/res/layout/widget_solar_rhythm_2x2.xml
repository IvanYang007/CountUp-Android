<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/solar_rhythm_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_zen_bg"
    android:padding="14dp"
    android:clipToOutline="true"
    tools:ignore="SmallSp">

    <!-- Active Content Container -->
    <RelativeLayout
        android:id="@+id/solar_rhythm_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top: Solar Term Badge -->
        <LinearLayout
            android:id="@+id/solar_rhythm_badge_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:background="@drawable/widget_solar_badge_bg"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp">

            <TextView
                android:id="@+id/solar_rhythm_badge_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:textColor="#FFFFFF"
                android:text="@string/solar_term_white_dew"
                tools:text="白露" />
        </LinearLayout>

        <!-- Center: Big Numeral & Title -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/solar_rhythm_days_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="34sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:textColor="#8A5A36"
                android:text="412"
                tools:text="412" />

            <TextView
                android:id="@+id/solar_rhythm_event_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:textColor="#8C7E70"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="@string/preview_item_tag"
                tools:text="SOBRIETY" />
        </LinearLayout>

        <!-- Bottom: Compact Timeline Track -->
        <ImageView
            android:id="@+id/solar_rhythm_timeline_track"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_alignParentBottom="true"
            android:scaleType="fitXY"
            android:src="@drawable/preview_solar_timeline_track"
            android:contentDescription="@null" />
    </RelativeLayout>

    <!-- Empty State Overlay -->
    <TextView
        android:id="@+id/solar_rhythm_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#8C7E70"
        android:text="@string/action_add_symbol"
        android:visibility="gone" />

</RelativeLayout>
