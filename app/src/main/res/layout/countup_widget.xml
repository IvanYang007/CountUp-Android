<?xml version="1.0" encoding="utf-8"?>
<!-- Ultra-minimalist Zen RemoteViews widget: dynamic ink background + full-width 3-column grid. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Active Chinese ink wash landscape background bitmap with zero-distortion centerCrop -->
    <ImageView
        android:id="@+id/widget_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Quiet minimalist title on top-left (12.5sp poised seal, 10dp top / 18dp start clears 28dp corner arc) -->
        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="18dp"
            android:paddingTop="10dp"
            android:paddingEnd="18dp"
            android:paddingBottom="5dp"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:textColor="#5D5043"
            android:text="@string/app_name" />

        <!-- 1dp subtle hairline editorial rule (#E3D3B8 at 40% opacity) inset by 16dp on both sides -->
        <ImageView
            android:id="@+id/widget_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="#66E3D3B8"
            android:contentDescription="@null" />

        <!-- Full-width 3-column habit grid with compact vertical spacing to eliminate bottom cutoff -->
        <GridView
            android:id="@+id/widget_grid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:numColumns="3"
            android:stretchMode="columnWidth"
            android:paddingStart="6dp"
            android:paddingTop="4dp"
            android:paddingEnd="6dp"
            android:paddingBottom="4dp"
            android:verticalSpacing="2dp"
            android:clipToPadding="false"
            android:scrollbars="none"
            android:listSelector="@android:color/transparent" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="6dp"
        android:textSize="13sp"
        android:text="@string/widget_empty"
        android:visibility="gone" />
</FrameLayout>
