<?xml version="1.0" encoding="utf-8"?>
<!--
  Shuin (金石朱印 · 1x1) Containerless Seal Layout
  Unboxed wabi-sabi cinnabar seal floating directly on the wallpaper with zero outer card frame.
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:gravity="center"
    tools:ignore="SmallSp">

    <!-- Cinnabar Stone Seal Plate: rendered procedural bitmap or vector preview fallback -->
    <ImageView
        android:id="@+id/shuin_seal_plate"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"
        android:scaleType="fitCenter"
        android:src="@drawable/preview_shuin_seal"
        android:contentDescription="@null" />

    <!-- Active Seal Typography Container (Nestled inside the seal plate) -->
    <LinearLayout
        android:id="@+id/shuin_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="2dp">

        <!-- Bold Bone-White Milestone Numeral (Auto-sizing 24sp down to 11sp with text-shadow) -->
        <TextView
            android:id="@+id/shuin_number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="11sp"
            android:autoSizeMaxTextSize="24sp"
            android:autoSizeStepGranularity="1sp"
            android:textStyle="bold"
            android:textColor="#FAF4EE"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="3"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:gravity="center"
            android:maxLines="1"
            android:text="42"
            tools:text="42" />

        <!-- Micro Letterpress Unit Label (e.g. DAYS / UNTIL) -->
        <TextView
            android:id="@+id/shuin_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="0.5dp"
            android:textSize="6.5sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:textColor="#C0FAF4EE"
            android:shadowColor="#60000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:text="@string/unit_days"
            tools:text="DAYS" />

        <!-- Item Name at the bottom — supports 2 lines with auto-sizing and ellipsize -->
        <TextView
            android:id="@+id/shuin_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1.5dp"
            android:paddingStart="3dp"
            android:paddingEnd="3dp"
            android:textSize="7.5sp"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="5.5sp"
            android:autoSizeMaxTextSize="8sp"
            android:autoSizeStepGranularity="0.5sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:textColor="#E8FAF4EE"
            android:shadowColor="#60000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:lineSpacingMultiplier="0.9"
            android:includeFontPadding="false"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="@string/preview_item_title"
            tools:text="SOBRIETY" />

    </LinearLayout>

    <!-- Empty State Overlay (Tap to bind counter) -->
    <TextView
        android:id="@+id/shuin_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#FAF4EE"
        android:text="@string/action_add_symbol"
        android:visibility="gone" />

</RelativeLayout>
