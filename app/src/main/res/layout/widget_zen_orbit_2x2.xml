<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/zen_orbit_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_zen_bg"
    android:padding="12dp"
    android:clipToOutline="true"
    tools:ignore="SmallSp">

    <!-- Active Content Container -->
    <RelativeLayout
        android:id="@+id/zen_orbit_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Background Concentric Dial Image -->
        <ImageView
            android:id="@+id/zen_orbit_dial"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            android:scaleType="fitCenter"
            android:src="@drawable/preview_zen_orbit_dial"
            android:contentDescription="@null" />

        <!-- Center Typography Overlay -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical">

            <!-- Event Tag — supports 2 lines with auto-sizing -->
            <TextView
                android:id="@+id/zen_orbit_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="9sp"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="6.5sp"
                android:autoSizeMaxTextSize="9sp"
                android:autoSizeStepGranularity="0.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:textColor="#7A6F62"
                android:lineSpacingMultiplier="0.92"
                android:includeFontPadding="false"
                android:gravity="center"
                android:maxLines="2"
                android:ellipsize="end"
                android:maxWidth="86dp"
                android:text="@string/preview_item_tag"
                tools:text="SOBER &amp;&#10;SERENE" />

            <!-- Big Numeral -->
            <TextView
                android:id="@+id/zen_orbit_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="30sp"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="14sp"
                android:autoSizeMaxTextSize="30sp"
                android:autoSizeStepGranularity="1sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:textColor="#2C2416"
                android:gravity="center"
                android:maxLines="1"
                android:singleLine="true"
                android:text="24"
                tools:text="24" />

            <!-- Unit Label -->
            <TextView
                android:id="@+id/zen_orbit_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="8.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:textColor="#7A6F62"
                android:text="@string/unit_days"
                tools:text="DAYS" />

            <!-- Rhythm Milestone Whisper (Quiet, unboxed whisper) -->
            <TextView
                android:id="@+id/zen_orbit_rhythm_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textSize="8.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.10"
                android:textColor="#9C8360"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="@string/preview_zen_orbit_pill"
                tools:text="AVG 28d" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Empty State Overlay -->
    <TextView
        android:id="@+id/zen_orbit_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#7A6F62"
        android:text="@string/action_add_symbol"
        android:visibility="gone" />

</RelativeLayout>
