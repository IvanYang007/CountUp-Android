<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/zen_horizon_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_zen_bg"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="10dp"
    android:clipToOutline="true"
    tools:ignore="SmallSp">

    <!-- Left tap area: Title and hairline track -->
    <LinearLayout
        android:id="@+id/zen_horizon_left_section"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_toStartOf="@+id/zen_horizon_right_section"
        android:layout_centerVertical="true"
        android:orientation="vertical"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/zen_horizon_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:textColor="#6B5D4F"
            android:singleLine="true"
            android:ellipsize="end"
            tools:text="SOBRIETY" />

        <ImageView
            android:id="@+id/zen_horizon_track"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginTop="4dp"
            android:scaleType="fitStart"
            android:contentDescription="@null" />
    </LinearLayout>

    <!-- Right tap area: In-place unit cycling numeral and unit label -->
    <LinearLayout
        android:id="@+id/zen_horizon_right_section"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="6dp"
        android:gravity="end|center_vertical"
        android:orientation="vertical"
        android:paddingStart="4dp">

        <TextView
            android:id="@+id/zen_horizon_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#2C2416"
            android:includeFontPadding="false"
            android:singleLine="true"
            tools:text="412" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/zen_horizon_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:textColor="#8C7E70"
                android:singleLine="true"
                tools:text="DAYS" />

            <TextView
                android:id="@+id/zen_horizon_unit_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="8.5sp"
                android:textColor="#DEB285"
                android:text="@string/zen_horizon_unit_hint" />
        </LinearLayout>
    </LinearLayout>

    <!-- Empty state overlay -->
    <TextView
        android:id="@+id/zen_horizon_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#8C7E70"
        android:text="@string/zen_horizon_empty"
        android:visibility="gone" />

</RelativeLayout>
