<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tsukimi_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_zen_bg"
    android:padding="2dp"
    android:clipToOutline="true"
    tools:ignore="SmallSp">

    <!-- Active Content Container: Hanging Scroll (Kakemono) Golden Ratio Split -->
    <LinearLayout
        android:id="@+id/tsukimi_widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <!-- Prominent Lunar Disc (112dp x 112dp) - Celestial Field -->
        <ImageView
            android:id="@+id/tsukimi_widget_moon_disc"
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:scaleType="fitCenter"
            android:src="@drawable/preview_tsukimi_moon"
            android:contentDescription="@null" />

        <!-- Terrestrial Milestone Pedestal (Proportional Golden Ratio anchoring) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <!-- Milestone Numeral: Elegant Serif Bold -->
            <TextView
                android:id="@+id/tsukimi_widget_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:textSize="32sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:textColor="#2C2416"
                android:gravity="center"
                android:singleLine="true"
                android:text="114"
                tools:text="114" />

            <!-- Micro Letterpress Unit Label (e.g. DAYS / UNTIL) -->
            <TextView
                android:id="@+id/tsukimi_widget_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textSize="8.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.14"
                android:textColor="#7A6F62"
                android:gravity="center"
                android:singleLine="true"
                android:text="@string/unit_days"
                tools:text="DAYS" />

            <!-- Counter Item Name at the bottom -->
            <TextView
                android:id="@+id/tsukimi_widget_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.10"
                android:textColor="#7A6F62"
                android:gravity="center"
                android:singleLine="true"
                android:ellipsize="end"
                android:maxWidth="140dp"
                android:text="@string/preview_item_tag"
                tools:text="SOBER &amp; SERENE" />

        </LinearLayout>

    </LinearLayout>

    <!-- Empty State Overlay -->
    <TextView
        android:id="@+id/tsukimi_widget_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#7A6F62"
        android:text="@string/tsukimi_empty"
        android:visibility="gone"
        tools:text="Tap to select a counter" />

</RelativeLayout>
