<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tsukimi_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_zen_bg"
    android:padding="2dp"
    android:clipToOutline="true"
    tools:ignore="SmallSp">

    <!-- Active Content Container: Proportional Moon & Pedestal Golden Ratio Split -->
    <LinearLayout
        android:id="@+id/tsukimi_widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <!-- Celestial Lunar Disc: Weighted flexible scaling adapting to any OEM launcher cell size -->
        <ImageView
            android:id="@+id/tsukimi_widget_moon_disc"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.2"
            android:scaleType="fitCenter"
            android:src="@drawable/preview_tsukimi_moon"
            android:contentDescription="@null" />

        <!-- Terrestrial Milestone Pedestal: Weighted container with auto-sizing typography -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.0"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="2dp"
            android:paddingEnd="2dp">

            <!-- Milestone Numeral: Elegant Serif Bold with autoSize -->
            <TextView
                android:id="@+id/tsukimi_widget_number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:textSize="30sp"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="14sp"
                android:autoSizeMaxTextSize="30sp"
                android:autoSizeStepGranularity="1sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:textColor="#2C2416"
                android:gravity="center"
                android:maxLines="1"
                android:singleLine="true"
                android:text="114"
                tools:text="114" />

            <!-- Micro Letterpress Unit Label (e.g. DAYS / UNTIL) -->
            <TextView
                android:id="@+id/tsukimi_widget_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textSize="8.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.14"
                android:textColor="#7A6F62"
                android:includeFontPadding="false"
                android:gravity="center"
                android:singleLine="true"
                android:text="@string/unit_days"
                tools:text="DAYS" />

            <!-- Counter Item Name at the bottom: 2 lines with auto-size -->
            <TextView
                android:id="@+id/tsukimi_widget_tag"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:textSize="10sp"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="7sp"
                android:autoSizeMaxTextSize="10sp"
                android:autoSizeStepGranularity="0.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:textColor="#7A6F62"
                android:lineSpacingMultiplier="0.92"
                android:includeFontPadding="false"
                android:gravity="center"
                android:maxLines="2"
                android:ellipsize="end"
                android:text="@string/preview_item_tag"
                tools:text="SOBER &amp; SERENE" />

        </LinearLayout>

    </LinearLayout>

    <!-- Empty State Overlay -->
    <TextView
        android:id="@+id/tsukimi_widget_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#7A6F62"
        android:text="@string/tsukimi_empty"
        android:visibility="gone"
        tools:text="Tap to select a counter" />

</RelativeLayout>
