<?xml version="1.0" encoding="utf-8"?>
<!--
  Universal 1x1 Zen Pebble layout — designed for worst-case 56dp OEM cells
  (Vivo OriginOS, Xiaomi HyperOS, OPPO ColorOS) while looking great on 80dp Pixel cells.
  Key constraints: 16dp corners, 2dp inner padding, auto-sizing text, compact spacing.
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToOutline="true"
    android:gravity="center"
    tools:ignore="SmallSp">

    <!-- Pebble Background Surface — corner radius handled by drawable (16dp base / system radius on v31) -->
    <ImageView
        android:id="@+id/zen_pebble_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_zen_bg"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <!-- Active Content Container — tight 2dp padding for maximum usable area -->
    <LinearLayout
        android:id="@+id/zen_pebble_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"
        android:padding="2dp"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Bold Serene Numeral — starts at 36sp, auto-sizes down to 12sp for multi-digit counts -->
        <TextView
            android:id="@+id/zen_pebble_number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="36sp"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeMaxTextSize="36sp"
            android:autoSizeStepGranularity="1sp"
            android:textStyle="bold"
            android:textColor="#2C2416"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:gravity="center"
            android:maxLines="1"
            android:text="42"
            tools:text="412" />

        <!-- Micro-Unit Label -->
        <TextView
            android:id="@+id/zen_pebble_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:textColor="#8C7E70"
            android:singleLine="true"
            android:text="@string/unit_days"
            tools:text="DAYS" />

        <!-- Hairline Ink Dash — prominent and peaceful -->
        <ImageView
            android:id="@+id/zen_pebble_dash"
            android:layout_width="28dp"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:background="#6B5D4F"
            android:contentDescription="@null" />

        <!-- Subtle One-Word Tag — single-line with ellipsize to fit any cell width -->
        <TextView
            android:id="@+id/zen_pebble_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:textColor="#46664B"
            android:singleLine="true"
            android:ellipsize="end"
            android:maxWidth="80dp"
            android:text="@string/preview_item_tag"
            tools:text="SOBRIETY" />
    </LinearLayout>

    <!-- Empty State Overlay -->
    <TextView
        android:id="@+id/zen_pebble_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#8C7E70"
        android:text="@string/action_add_symbol"
        android:visibility="gone" />

</RelativeLayout>
