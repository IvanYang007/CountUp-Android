<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/solar_rhythm_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_zen_bg"
    android:paddingStart="20dp"
    android:paddingTop="14dp"
    android:paddingEnd="20dp"
    android:paddingBottom="14dp"
    android:clipToOutline="true"
    tools:ignore="SmallSp">

    <!-- Active Content Container -->
    <RelativeLayout
        android:id="@+id/solar_rhythm_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 1. Top Bar: Solar Term Badge + Whisper Couplet Quote -->
        <LinearLayout
            android:id="@+id/solar_rhythm_top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/solar_rhythm_badge_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_solar_badge_bg"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp">

                <TextView
                    android:id="@+id/solar_rhythm_badge_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:textColor="#FFFFFF"
                    tools:text="白露" />
            </LinearLayout>

            <TextView
                android:id="@+id/solar_rhythm_quote"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:gravity="end"
                android:textSize="10sp"
                android:textStyle="italic"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="#8C7E70"
                tools:text="“暑气渐消秋意静，蜻蜓低掠晚霞明”" />
        </LinearLayout>

        <!-- Hairline Divider -->
        <ImageView
            android:id="@+id/solar_rhythm_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_below="@+id/solar_rhythm_top_bar"
            android:layout_marginTop="6dp"
            android:background="#1F000000"
            android:contentDescription="@null" />

        <!-- 3. Bottom: Seasonal Timeline Track & Labels -->
        <LinearLayout
            android:id="@+id/solar_rhythm_bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/solar_rhythm_current_term"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="9sp"
                    android:textColor="#8C7E70"
                    tools:text="白露" />

                <TextView
                    android:id="@+id/solar_rhythm_term_day_progress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textSize="9sp"
                    android:textColor="#8C7E70"
                    tools:text="Day 5 of 15" />

                <TextView
                    android:id="@+id/solar_rhythm_next_term"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:textSize="9sp"
                    android:textColor="#8C7E70"
                    tools:text="秋分" />
            </LinearLayout>

            <ImageView
                android:id="@+id/solar_rhythm_timeline_track"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="3dp"
                android:scaleType="fitXY"
                android:contentDescription="@null" />
        </LinearLayout>

        <!-- 2. Middle: Event Name & Subtitle on Left, Large Numeral on Right -->
        <RelativeLayout
            android:id="@+id/solar_rhythm_middle_row"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/solar_rhythm_divider"
            android:layout_above="@+id/solar_rhythm_bottom_bar"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@+id/solar_rhythm_right_count_box"
                android:layout_centerVertical="true"
                android:layout_marginEnd="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/solar_rhythm_event_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#2C2416"
                    android:singleLine="true"
                    android:ellipsize="end"
                    tools:text="Sobriety Streak" />

                <TextView
                    android:id="@+id/solar_rhythm_event_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="10.5sp"
                    android:textColor="#8C7E70"
                    android:singleLine="true"
                    android:ellipsize="end"
                    tools:text="Since Jan 20, 2025" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/solar_rhythm_right_count_box"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="end|center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/solar_rhythm_days_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    android:textColor="#8A5A36"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    tools:text="412" />

                <TextView
                    android:id="@+id/solar_rhythm_days_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="#8A5A36"
                    android:letterSpacing="0.1"
                    android:text="DAYS" />
            </LinearLayout>
        </RelativeLayout>

    </RelativeLayout>

    <!-- Empty State Overlay -->
    <TextView
        android:id="@+id/solar_rhythm_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#8C7E70"
        android:text="@string/zen_horizon_empty"
        android:visibility="gone" />

</RelativeLayout>
