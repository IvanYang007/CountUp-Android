<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+: selectively enable cloud backup and device-to-device transfer for core database files. -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="sharedpref" path="countup_prefs.xml" />
        <include domain="file" path="countup_backup.json" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="countup_prefs.xml" />
        <include domain="file" path="countup_backup.json" />
    </device-transfer>
</data-extraction-rules>
