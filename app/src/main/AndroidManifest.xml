<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Defensive zero-permission guard: widget/UI support libraries may merge
      optional permissions into the manifest. This app has no network, boot, or
      background-work feature, so each is explicitly removed before merge to
      satisfy the zero-permission requirement of the plan.
    -->
    <uses-permission android:name="android.permission.WAKE_LOCK" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />
    <uses-permission android:name="com.countup.app.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" tools:node="remove" />

    <!-- Package visibility: Android 11+ requires explicit query declarations for speech services -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.CountUp">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="countup" android:host="new" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Dedicated Translucent Voice Quick Add Activity -->
        <activity
            android:name=".VoiceAddActivity"
            android:exported="false"
            android:theme="@style/Theme.CountUp.Translucent"
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:windowSoftInputMode="adjustResize" />

        <receiver
            android:name=".CountUpWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/haircut_widget_info" />
        </receiver>

        <!-- Focused Hero Milestone Widget (2x1) -->
        <receiver
            android:name=".HeroWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.appwidget.action.APPWIDGET_DELETED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/hero_widget_info" />
        </receiver>

        <!-- Configuration Activity for Hero Widget -->
        <activity
            android:name=".HeroWidgetConfigureActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Zen Horizon Ribbon Widget (4x1 & 2x1) -->
        <receiver
            android:name=".ZenHorizonWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.appwidget.action.APPWIDGET_DELETED" />
                <action android:name="com.countup.app.ACTION_CYCLE_ZEN_HORIZON_UNIT" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/zen_horizon_widget_info" />
        </receiver>

        <!-- Configuration Activity for Zen Horizon Widget -->
        <activity
            android:name=".ZenHorizonConfigureActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>


        <!-- Solar Rhythm 4x2 / 2x2 Seasonal Canvas -->
        <receiver
            android:name=".SolarRhythmWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.appwidget.action.APPWIDGET_DELETED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/solar_rhythm_widget_info" />
        </receiver>

        <!-- Configuration Activity for Solar Rhythm Widget -->
        <activity
            android:name=".SolarRhythmConfigureActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Zen Pebble (1x1 极简原石) -->
        <receiver
            android:name=".ZenPebbleWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.appwidget.action.APPWIDGET_DELETED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/zen_pebble_widget_info" />
        </receiver>

        <!-- Configuration Activity for Zen Pebble Widget -->
        <activity
            android:name=".ZenPebbleConfigureActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Serves the widget grid's cell views to the launcher. Exported=false
             is safe: only the system can hold BIND_REMOTEVIEWS. -->
        <service
            android:name=".CountUpWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!-- Handles per-cell reset taps from the widget grid (fill-in intents). -->
        <receiver
            android:name=".ResetCountReceiver"
            android:exported="false" />

        <!-- Silent Midnight Rollover Alarm Receiver -->
        <receiver
            android:name=".MidnightAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.countup.app.ACTION_MIDNIGHT_ROLLOVER" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!--
          Defensive initialization provider removal: guarantees no transitive library
          spawns background initializers or unneeded background services.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            tools:node="remove"
            tools:ignore="MissingClass" />

    </application>

</manifest>
